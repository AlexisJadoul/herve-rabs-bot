DISCORD_TOKEN=colle_ici_le_token_discord
OPENROUTER_API_KEY=colle_ici_ta_cle_openrouter

# Modele OpenRouter
OPENROUTER_MODEL=mistralai/mistral-7b-instruct:free

# Humeur par defaut : collegue, fatigue, corporate, calme, beaufgentil
BOT_HUMEUR=collegue

# Chance de repondre sans mention, en pourcentage
# Exemple : 8 = 8 %
SPONTANEOUS_CHANCE=8

# Silence avant relance automatique, en minutes
IDLE_MIN_MINUTES=10
IDLE_MAX_MINUTES=30

# Cooldown global du bot, en minutes
BOT_COOLDOWN_MINUTES=5

# Facultatif : limite le bot a certains salons
# Mets les IDs separes par une virgule
# Exemple : 123456789,987654321
ALLOWED_CHANNEL_IDS=

# Facultatif : IDs Discord qui ont le droit de faire !context et !blague
# Si vide, les admins et les personnes avec "Gerer le serveur" peuvent le faire
BOT_ADMIN_IDS=
